# Copy to .env.local (gitignored). Both founders use the SAME Supabase project and the same values.
ANTHROPIC_API_KEY=sk-ant-...
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional, comma-separated. Lets the login form reject non-founder emails before calling Supabase.
# The real gate is the founder_allowlist table in Supabase.
NEXT_PUBLIC_FOUNDER_EMAILS=you@example.com,cofounder@example.com
